<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hkd.mapper.SysDeptDao">
    
    <resultMap id="SysDeptResultMap" type="com.hkd.pojo.SysDept">
        <id column="dept_id" property="deptId" />
        <result column="dept_name" property="deptName" />
        <result column="manager_id" property="managerId" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
    </resultMap>
    
    <select id="findAll" resultMap="SysDeptResultMap">
        SELECT * FROM sys_dept limit #{offset},#{pageSize}
    </select>

    <select id="findAllCount" resultType="int">
        SELECT count(*) from sys_dept
    </select>

    <select id="findByDeptName" resultMap="SysDeptResultMap">
        SELECT * from sys_dept where dept_name like concat('%',#{deptName},'%') limit #{offset},#{pageSize}
    </select>

    <select id="findCount" resultType="int">
        SELECT count(*) from sys_dept where dept_name like concat('%',#{deptName},'%')
    </select>
    
    <select id="findById" parameterType="int" resultMap="SysDeptResultMap">
        SELECT * FROM sys_dept WHERE dept_id = #{deptId}
    </select>

    <insert id="insert" parameterType="com.hkd.pojo.SysDept" useGeneratedKeys="true" keyProperty="deptId">
        INSERT INTO sys_dept(dept_name, manager_id, status, create_time)
        VALUES(#{deptName}, #{managerId}, #{status}, #{createTime})
    </insert>
    
    <update id="update" parameterType="com.hkd.pojo.SysDept">
        UPDATE sys_dept SET
            dept_name = #{deptName},
            manager_id = #{managerId},
            status = #{status}
        WHERE dept_id = #{deptId}
    </update>
    
    <delete id="delete" parameterType="int">
        DELETE FROM sys_dept WHERE dept_id = #{deptId}
    </delete>
    
    <select id="findByStatus" parameterType="byte" resultMap="SysDeptResultMap">
        SELECT * FROM sys_dept WHERE status = #{status}
    </select>
    
    <select id="findByManagerId" parameterType="int" resultMap="SysDeptResultMap">
        SELECT * FROM sys_dept WHERE manager_id = #{managerId}
    </select>
</mapper>