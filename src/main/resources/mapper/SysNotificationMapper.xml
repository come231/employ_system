<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hkd.mapper.SysNotificationDao">

    <resultMap id="BaseResultMap" type="com.hkd.pojo.SysNotification">
        <id column="notification_id" property="notificationId"/>
        <result column="user_id" property="userId"/>
        <result column="type" property="type"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="related_id" property="relatedId"/>
        <result column="is_read" property="isRead"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 根据用户ID查询通知列表 -->
    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT * FROM sys_notification
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- 查询未读通知数量 -->
    <select id="countUnreadByUserId" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM sys_notification
        WHERE user_id = #{userId} AND is_read = 0
    </select>

    <!-- 查询通知总数 -->
    <select id="countByUserId" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM sys_notification WHERE user_id = #{userId}
    </select>

    <!-- 根据ID查询通知 -->
    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM sys_notification WHERE notification_id = #{notificationId}
    </select>

    <!-- 新增通知 -->
    <insert id="insert" parameterType="com.hkd.pojo.SysNotification" useGeneratedKeys="true" keyProperty="notificationId">
        INSERT INTO sys_notification (user_id, type, title, content, related_id, is_read, create_time)
        VALUES (#{userId}, #{type}, #{title}, #{content}, #{relatedId}, #{isRead}, #{createTime})
    </insert>

    <!-- 标记为已读 -->
    <update id="markAsRead">
        UPDATE sys_notification SET is_read = 1 WHERE notification_id = #{notificationId}
    </update>

    <!-- 标记用户所有通知为已读 -->
    <update id="markAllAsRead">
        UPDATE sys_notification SET is_read = 1 WHERE user_id = #{userId}
    </update>

    <!-- 删除通知 -->
    <delete id="delete">
        DELETE FROM sys_notification WHERE notification_id = #{notificationId}
    </delete>

    <!-- 删除用户的所有通知 -->
    <delete id="deleteByUserId">
        DELETE FROM sys_notification WHERE user_id = #{userId}
    </delete>
</mapper>
